{
  "id": "little-light-gatherer",
  "title": "The Little Light Gatherer and the Grey Giant",
  "shortTitle": "The Little Light Gatherer and the Grey Giant",
  "subtitle": "Gathering the light, piece by piece",
  "description": "The Grey Giant has stolen the morning, so little Man sets out with a tin box to gather the scattered light. Everything he sees is a fairy tale—until the final page gently turns.",
  "mode": null,
  "shuffleActions": false,
  "assetBase": "worlds/little-light-gatherer/",
  "cover": {
    "default": "assets/cover.webp"
  },
