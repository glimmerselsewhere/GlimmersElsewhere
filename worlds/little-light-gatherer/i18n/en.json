      "image": "assets/images/endings/ending-dawn.webp"
    },
    {
      "id": "ending-story",
      "title": "The Story Closes",
      "description": "The sun was never stolen. War held the city, and a rescuer led Man through it. Kindness kept the tale alive. His mother waits quietly at dawn station.",
      "all": [
        {
          "state": "imagination",
          "operator": ">=",
          "value": 10
        }
      ],
      "image": "assets/images/endings/ending-story.webp"
    },
    {
      "id": "ending-ordinary",
      "title": "Warm in the Palm",
      "description": "The night ends. Not a knight, but a weary young man guided him. The ruins hold no monster, only a protected road. His mother waits at the evacuation dawn station.",
      "all": [],
      "image": "assets/images/endings/ending-ordinary.webp"
    }
  ],
