    "image": "assets/images/image2/awakening.webp"
  },
  "ui": {
    "backToCatalog": "← 返回目录",
    "introButton": "踏入仙途",
    "continueButton": "踏上前路",
    "finalContinueButton": "迎接天命",
    "replayButton": "再走一遍仙途"
  },
  "catalog": {
    "eyebrow": "第三片异境微光已经苏醒",
    "cardDescription": "家猫误触玉佩，闯入修仙界。不会陨落，只会以意想不到的方式成仙。",
    "cardIcon": "玉",
    "cardLabel": "WORLD 03",
    "cardGradient": [
      "#6ec4c0",
