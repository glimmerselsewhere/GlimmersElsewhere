{
  "id": "jade-cat",
  "title": "玉猫登仙",
  "shortTitle": "玉猫登仙",
  "subtitle": "热血又贪吃的修仙猫",
  "description": "一枚玉佩把家猫送进修仙界。修为、肚腩与道德，将共同决定它最后成为什么仙。",
  "music": "assets/audio/jade-cat-ascension.mp3",
  "musicVolume": 0.1,
  "assetBase": "worlds/jade-cat/",
  "opening": {
