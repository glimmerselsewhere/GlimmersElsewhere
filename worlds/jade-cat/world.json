      "name": "潜心修炼",
      "plain": "修炼",
      "icon": "修"
    },
    {
      "id": "eat",
      "name": "先吃再说",
      "plain": "吃",
      "icon": "吃"
    },
    {
      "id": "heart",
      "name": "守住猫心",
      "plain": "守心",
      "icon": "善"
    }
  ],
  "scenes": [
    {
      "id": "awakening",
      "chapter": "缘起",
      "image": "assets/images/image2/awakening.webp",
      "title": "玉佩醒了，猫也醒了",
      "description": "午后的房间里，一枚旧玉佩突然发光。你只是伸爪碰了一下，天地便翻转过来——这段仙途一定会开始。",
      "actions": [
        {
          "id": "touch",
          "name": "伸爪触碰玉佩",
          "plain": "触碰",
          "hint": "命中注定的一爪",
          "icon": "玉"
        }
      ],
      "outcomes": {
        "touch": {
          "image": "assets/images/image2/awakening.webp",
          "stateChanges": {
            "cultivation": 1,
            "belly": 0,
            "morality": 0
          },
          "text": "玉佩化作一道清光，你落在云海之上的青玉宗门前。仙途由此开启，这一步不会改变最终立场。"
        }
      }
    },
    {
      "id": "gate-trial",
      "chapter": "第一试",
      "image": "assets/images/image2/trial.webp",
      "title": "山门只收有缘猫",
      "description": "长老让你任选一种入门试炼。剑坪、丹房与聚灵阵同时亮起，灵果园还飘来一阵甜香。",
      "actions": [
        {
          "id": "sword",
          "name": "挥动小木剑",
          "plain": "练剑",
          "hint": "正面通过剑坪",
          "icon": "剑"
        },
        {
          "id": "alchemy",
          "name": "钻进炼丹房",
          "plain": "炼丹",
          "hint": "研究会发光的丹炉",
          "icon": "丹"
        },
        {
          "id": "absorb",
          "name": "坐进聚灵阵",
          "plain": "吸收灵气",
          "hint": "安静吐纳一整轮",
          "icon": "气"
        },
        {
          "id": "steal-fruit",
          "name": "溜去偷吃灵果",
          "plain": "偷吃",
          "hint": "果子看起来实在太甜",
          "icon": "果"
        }
      ],
      "outcomes": {
        "sword": {
          "image": "assets/images/image2/trial.webp",
          "stateChanges": {
            "cultivation": 3,
            "belly": 0,
            "morality": 1
          },
          "text": "木剑比你高，但你追着剑穗扑了三百回，意外练成一套迅捷猫剑。"
        },
        "alchemy": {
          "image": "assets/images/image2/trial.webp",
          "stateChanges": {
            "cultivation": 2,
            "belly": 1,
            "morality": 1
          },
          "text": "你把丹炉守得很好，只试吃了一颗圆滚滚的成品。长老决定睁一只眼闭一只眼。"
        },
        "absorb": {
          "image": "assets/images/image2/trial.webp",
          "stateChanges": {
            "cultivation": 4,
            "belly": 0,
            "morality": 0
          },
          "text": "灵气顺着胡须涌入经脉。你打了个哈欠，修为却结结实实涨了一截。"
        },
        "steal-fruit": {
          "image": "assets/images/image2/spirit-fruit.webp",
          "stateChanges": {
            "cultivation": 1,
            "belly": 3,
            "morality": -1
          },
          "text": "灵果入口即化，肚子也立刻圆了一圈。守园仙鹤把你的名字记在了小本上。"
        }
      }
    },
    {
      "id": "mouse-swordsman",
      "chapter": "山路遇邪",
      "image": "assets/images/image2/mouse-swordsman.webp",
      "title": "邪修鼠剑仙拦住了去路",
      "description": "鼠剑仙拔剑索要你的玉佩。他看起来很凶，尾巴却因为紧张打了一个结。",
      "actions": [
        {
          "id": "duel",
          "name": "正面接下鼠剑",
          "plain": "迎战",
          "hint": "用刚学会的猫剑",
          "icon": "战"
        },
        {
          "id": "share",
          "name": "分他一块小鱼干",
          "plain": "讲和",
          "hint": "也许邪修只是饿了",
          "icon": "鱼"
        },
        {
          "id": "trick",
          "name": "假装看见宗门长老",
          "plain": "骗开",
          "hint": "趁他回头溜过去",
          "icon": "计"
        }
      ],
      "outcomes": {
        "duel": {
          "image": "assets/images/image2/mouse-swordsman.webp",
          "stateChanges": {
            "cultivation": 3,
            "belly": 0,
            "morality": 0
          },
          "text": "你用爪垫夹住剑尖，鼠剑仙大惊失色，承认这是一场公平的较量。"
        },
        "share": {
          "image": "assets/images/image2/mouse-swordsman.webp",
          "stateChanges": {
            "cultivation": 1,
            "belly": -1,
            "morality": 3
          },
          "text": "鼠剑仙吃完小鱼干，决定不再抢玉佩，还偷偷告诉你秘境入口的位置。"
        },
        "trick": {
          "image": "assets/images/image2/mouse-swordsman.webp",
          "stateChanges": {
            "cultivation": 0,
            "belly": 0,
            "morality": -2
          },
          "text": "鼠剑仙回头的一瞬间，你已经跑远。没人受伤，但这招显然不太光明。"
        }
      }
    },
    {
      "id": "secret-realm",
      "chapter": "秘境初开",
      "image": "assets/images/image2/secret-realm.webp",
      "title": "无主秘境在月下开启",
      "description": "山壁中出现一扇旋转的光门。里面可能藏着仙缘，也可能只有迷路三百年的台阶。",
      "actions": [
        {
          "id": "enter",
          "name": "立刻钻进秘境",
          "plain": "进入",
          "hint": "机缘从不等猫",
          "icon": "入"
        },
        {
          "id": "escort",
          "name": "先等同门结伴",
          "plain": "结伴",
          "hint": "一起进去更稳妥",
          "icon": "伴"
        },
        {
          "id": "leave",
          "name": "在门口晒月亮",
          "plain": "不进",
          "hint": "修仙也要量力而行",
          "icon": "月"
        }
      ],
      "outcomes": {
        "enter": {
          "image": "assets/images/image2/secret-realm.webp",
          "stateChanges": {
            "cultivation": 4,
            "belly": 0,
            "morality": 0
          },
          "text": "你追着一束灵光连闯三道幻境，带回一缕精纯仙气。"
        },
        "escort": {
          "image": "assets/images/image2/secret-realm.webp",
          "stateChanges": {
            "cultivation": 2,
            "belly": 0,
            "morality": 2
          },
          "text": "你与同门互相照应，虽然宝物不多，却把每一只猫都完整带了出来。"
        },
        "leave": {
          "image": "assets/images/image2/secret-realm.webp",
          "stateChanges": {
            "cultivation": 0,
            "belly": 1,
            "morality": 1
          },
          "text": "你没有冒险，在门口等到了送夜宵的灵厨弟子。平安也是一种仙缘。"
        }
      }
    },
    {
      "id": "injured-brother",
      "chapter": "道心一问",
      "image": "assets/images/image2/injured-brother.webp",
      "title": "重伤师兄守着一只宝匣",
      "description": "师兄倒在石阶旁，请你替他把宝匣送回宗门。匣中灵光四溢，附近没有别人。",
      "actions": [
        {
          "id": "rescue",
          "name": "背起师兄和宝匣",
          "plain": "相救",
          "hint": "一起送回宗门",
          "icon": "义"
        },
        {
          "id": "take",
          "name": "拿走宝匣独自离开",
          "plain": "夺宝",
          "hint": "无人知道这里发生过什么",
          "icon": "夺"
        },
        {
          "id": "signal",
          "name": "放出信符呼叫长老",
          "plain": "求援",
          "hint": "留在原地守候",
          "icon": "援"
        }
      ],
      "outcomes": {
        "rescue": {
          "image": "assets/images/image2/injured-brother.webp",
          "stateChanges": {
            "cultivation": 1,
            "belly": 0,
            "morality": 4
          },
          "text": "你一路拖着比自己还重的师兄回山。宝匣完好无损，道心也更加澄明。"
        },
        "take": {
          "image": "assets/images/image2/injured-brother.webp",
          "stateChanges": {
            "cultivation": 4,
            "belly": 0,
            "morality": -5
          },
          "text": "宝匣中的秘术让修为猛涨，但玉佩表面悄悄浮现出一道暗纹。师兄后来也被长老救回，并未丧命。"
        },
        "signal": {
          "image": "assets/images/image2/injured-brother.webp",
          "stateChanges": {
            "cultivation": 0,
            "belly": 0,
            "morality": 3
          },
          "text": "长老很快赶到。你守住了宝匣和师兄，也没有拿不属于自己的东西。"
        }
      }
    },
    {
      "id": "spirit-fruit",
      "chapter": "最后一夜",
      "image": "assets/images/image2/spirit-fruit.webp",
      "title": "渡劫前只剩一颗万年灵果",
      "description": "灵果能增加修为，也能做成足够吃三天的果泥。此刻的选择会让雷劫记住你的形状。",
      "actions": [
        {
          "id": "refine",
          "name": "炼化整颗灵果",
          "plain": "炼化",
          "hint": "把灵力纳入经脉",
          "icon": "炼"
        },
        {
          "id": "feast",
          "name": "蘸着鱼泥全部吃掉",
          "plain": "开吃",
          "hint": "渡劫也不能饿肚子",
          "icon": "饱"
        },
        {
          "id": "share-fruit",
          "name": "分给受伤的同门",
          "plain": "分享",
          "hint": "自己只留下一小瓣",
          "icon": "分"
        }
      ],
      "outcomes": {
        "refine": {
          "image": "assets/images/image2/spirit-fruit.webp",
          "stateChanges": {
            "cultivation": 4,
            "belly": 1,
            "morality": 0
          },
          "text": "灵果化作金色灵流，修为直逼渡劫门槛，胡须末端都闪起电光。"
        },
        "feast": {
          "image": "assets/images/image2/spirit-fruit.webp",
          "stateChanges": {
            "cultivation": 1,
            "belly": 5,
            "morality": 0
          },
          "text": "你吃得心满意足，圆滚滚地躺到天亮。灵气没少，只是大多长在了肚腩上。"
        },
        "share-fruit": {
          "image": "assets/images/image2/spirit-fruit.webp",
          "stateChanges": {
            "cultivation": 1,
            "belly": 0,
            "morality": 4
          },
          "text": "同门伤势尽复，众猫为你护法。你没有得到最多灵气，却得到了最稳固的道心。"
        }
      }
    },
    {
      "id": "tribulation",
      "chapter": "渡劫登仙",
      "image": "assets/images/image2/tribulation.webp",
      "title": "九重雷云落在玉猫峰顶",
      "description": "雷劫轰鸣，却不会伤害你。它只会照见一路积累的修为、肚腩和道德，然后给出最适合你的仙位。",
      "actions": [
        {
          "id": "face-thunder",
          "name": "踏云正面迎雷",
          "plain": "迎雷",
          "hint": "相信一路修来的力量",
          "icon": "雷"
        },
        {
          "id": "guard-dao",
          "name": "以道心护住同门",
          "plain": "护道",
          "hint": "先挡住落向山门的雷光",
          "icon": "护"
        },
        {
          "id": "dark-jade",
          "name": "催动玉佩中的暗纹",
          "plain": "借邪力",
          "hint": "用捷径吞下雷光",
          "icon": "暗"
        }
      ],
      "outcomes": {
        "face-thunder": {
          "image": "assets/images/image2/tribulation.webp",
          "stateChanges": {
            "cultivation": 3,
            "belly": 0,
            "morality": 0
          },
          "text": "你跃入雷光，尾巴划出一道金色弧线。雷声过后，仙门缓缓开启。"
        },
        "guard-dao": {
          "image": "assets/images/image2/tribulation.webp",
          "stateChanges": {
            "cultivation": 1,
            "belly": 0,
            "morality": 3
          },
          "text": "雷光被你引向云海，整座山门安然无恙。众猫的愿力托住了你的仙途。"
        },
        "dark-jade": {
          "image": "assets/images/image2/tribulation.webp",
          "stateChanges": {
            "cultivation": 4,
            "belly": 0,
            "morality": -4
          },
          "text": "暗纹吞没雷光，你没有受伤，却踏上了一条不再受宗门约束的邪仙之路。"
        }
      }
    }
  ],
