      "actions": [
        {
          "id": "dry",
          "name": "Stay dry",
          "hint": "Stop getting wet",
          "icon": "A"
        },
        {
          "id": "mud",
          "name": "Roll in the mud",
          "hint": "You will get dirty",
          "icon": "B"
        },
        {
          "id": "call",
          "name": "Call into the rain",
          "hint": "Maybe someone hears",
          "icon": "C"
        }
      ],
      "outcomes": {
        "dry": {
          "text": "The car blocks most of the rain, though your fur grows heavy.",
          "stateChanges": {
            "health": 2
          }
        },
        "mud": {
          "text": "Mud covers your white fur, making you look even less like a house cat.",
          "stateChanges": {
            "charm": -1
          }
        },
        "call": {
          "text": "The rain is loud, but you call anyway.",
          "stateChanges": {}
        }
      }
    },
