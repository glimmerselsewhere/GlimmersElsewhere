    {
      "id": "cardboard",
      "chapter": "Q1 · Months 0-3",
      "title": "The First Sound in the Box",
      "description": "Ah Hui was born in a cardboard box behind a convenience store. His fur is white, but dust makes him look gray.",
      "image": "assets/images/scenes/cardboard.webp",
      "actions": [
        {
          "id": "cry",
          "name": "Cry loudly",
          "hint": "Be heard",
          "icon": "A"
        },
        {
          "id": "hide",
          "name": "Hide deeper",
          "hint": "Protect yourself",
          "icon": "B"
        },
        {
          "id": "explore",
          "name": "Climb out",
          "hint": "See outside",
          "icon": "C"
        }
      ],
      "outcomes": {
        "cry": {
          "text": "Your cry makes someone stop.",
          "stateChanges": {
            "health": 2,
            "fish": 1
          }
        },
        "hide": {
          "text": "You curl up, and the box becomes a small mountain.",
          "stateChanges": {
            "health": 1
          }
        },
        "explore": {
          "text": "You touch the ground; the world is bigger than the box.",
          "stateChanges": {
            "health": -1,
            "fish": 0
          }
        }
      }
    },
    {
