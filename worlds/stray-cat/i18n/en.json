      "actions": [
        {
          "id": "dry",
          "name": "Stay dry",
          "hint": "Stop getting wet",
          "icon": "A"
        },
        {
          "id": "move",
          "name": "Move deeper",
          "hint": "Find a safer spot",
          "icon": "B"
        },
        {
          "id": "call",
          "name": "Call into the rain",
          "hint": "Maybe someone hears",
          "icon": "C"
        }
      ],
      "outcomes": {
        "dry": {
          "text": "The car blocks most of the rain, though your fur grows heavy.",
          "stateChanges": {
            "health": 2
          }
        },
        "move": {
          "text": "You cross the waterline and find a drier patch of concrete.",
          "stateChanges": {
            "fish": 0
          }
        },
        "call": {
          "text": "The rain is loud, but you call anyway.",
          "stateChanges": {}
        }
      }
